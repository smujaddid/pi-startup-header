{
  "name": "@smujaddid/pi-startup-header",
  "version": "0.1.0",
  "description": "Theme-aware gradient ASCII startup header for the Pi coding agent.",
  "type": "module",
  "license": "MIT",
  "author": "Sibghatullah Mujaddid",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "pi-header",
