    "url": "https://github.com/smujaddid/pi-startup-header/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smujaddid/pi-startup-header.git"
  },
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "test:types": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.0",
    "@earendil-works/pi-tui": "^0.84.0",
    "@types/node": "^24.10.0",
    "tsx": "^4.23.10",
    "typescript": "^5.9.3"
  }
